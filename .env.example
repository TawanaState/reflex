# Project Reflex Configuration Example
# Copy to .env and adjust variables as needed

# Hugging Face Access Token (required if downloading gated model checkpoints)
HF_TOKEN="your_hf_token_here"

# Path to local model snapshot directory or Hugging Face repo ID
# e.g., "google/diffusiongemma-26B-A4B-it" or local directory
DIFFUSION_GEMMA_PATH="google/diffusiongemma-26B-A4B-it"

# Optional LoRA adapter path. Leave pointing at a nonexistent path (default)
# to run the base model's native tool-calling path, which is what
# RESULTS.md's measured accuracy numbers reflect. models/reflex_lora_v1 and
# v2 were trained for a retired tool-index-selection scheme and have NOT been
# validated against native tool calling -- do not point this at them unless
# you have re-validated that combination yourself.
REFLEX_LORA_PATH="models/reflex_lora_v2_native_UNVALIDATED"

# Runtime Execution Mode:
# 'reflex'  - Native DiffusionGemma tool-calling with atomic draft exits.
#             Experimental typed-scalar draft exits are opt-in below.
# 'vanilla' - Standard fixed multi-step canvas denoising baseline
REFLEX_MODE="reflex"

# Require this many consecutive complete native atomic calls in denoising
# drafts before exiting. Set REFLEX_ATOMIC_EARLY_EXIT=false for the official
# full-generation baseline. This stability rule is not a calibrated correctness probability.
REFLEX_ATOMIC_EARLY_EXIT=true
REFLEX_ATOMIC_STABLE_STEPS=1

# Experimental: stop on a fully specified typed-scalar call only after the
# exact validated name+arguments remain stable across consecutive drafts.
# Open strings, arrays, objects, and missing optional fields cannot exit.
REFLEX_SCALAR_EARLY_EXIT=false
REFLEX_SCALAR_STABLE_STEPS=2

# Server Bind Address and Port
HOST="0.0.0.0"
PORT=8090

# Conformal Risk Error Tolerance (epsilon: maximum tolerated error rate on fast-path exits)
CONFORMAL_EPS=0.02

# Target PyTorch Device
DEVICE="cuda:0"

# Maximum generative expansion buffer length
MAX_CANVAS_LENGTH=256

